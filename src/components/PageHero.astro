---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  highlights?: string[];
}

const { eyebrow, title, description, highlights = [] } = Astro.props;
---

<section class="shell pt-10 sm:pt-12 md:pt-14">
  <div class="hero-frame surface-grid">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-300/60 to-transparent"></div>
    <div class:list={[
      'grid gap-8',
      highlights.length > 0 && 'xl:grid-cols-[1.08fr_0.92fr] xl:items-end'
    ]}>
      <div class="max-w-3xl space-y-6">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 class="page-title">{title}</h1>
        <p class="page-copy">{description}</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <slot name="actions" />
        </div>
      </div>

      {highlights.length > 0 && (
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-1">
          {highlights.map((item, index) => (
            <div class="soft-card flex items-start gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-cyan-300/20 bg-cyan-300/10 font-display text-sm text-cyan-100">
                0{index + 1}
              </span>
              <p class="text-sm leading-7 text-slate-200 sm:text-base">{item}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
