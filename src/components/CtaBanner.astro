---
interface Props {
  title: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel
} = Astro.props;
---

<section class="shell section-space pt-0">
  <div class="hero-frame mesh-card">
    <div class="grid gap-8 xl:grid-cols-[1.05fr_0.95fr] xl:items-end">
      <div class="space-y-5">
        <span class="eyebrow">Next step</span>
        <h2 class="section-title">{title}</h2>
        <p class="section-copy">{description}</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={primaryHref} class="button-primary">{primaryLabel}</a>
          {secondaryHref && secondaryLabel && (
            <a href={secondaryHref} class="button-secondary">{secondaryLabel}</a>
          )}
        </div>
      </div>

      <div class="grid gap-3 md:grid-cols-3 xl:grid-cols-1">
        <div class="soft-card">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Static-first</p>
          <p class="mt-3 text-sm leading-7 text-slate-200">Fast rendering, low client overhead, and cleaner mobile behavior.</p>
        </div>
        <div class="soft-card">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Route-ready SEO</p>
          <p class="mt-3 text-sm leading-7 text-slate-200">Solution, industry, trust, and insight routes already work as a growth system.</p>
        </div>
        <div class="soft-card">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Scalable design</p>
          <p class="mt-3 text-sm leading-7 text-slate-200">The visual system is compact enough to extend without losing focus.</p>
        </div>
      </div>
    </div>
  </div>
</section>
