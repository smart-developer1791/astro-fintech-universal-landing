---
import { site } from '../data/site';
---

<footer class="mt-24 pb-8">
  <div class="shell">
    <div class="panel rounded-[32px] px-5 py-8 sm:px-7 lg:px-10 lg:py-10">
      <div class="grid gap-10 lg:grid-cols-[1.35fr_0.9fr_0.9fr]">
        <div class="space-y-5">
          <a href="/" class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.2em] text-slate-100">
            <span class="flex h-11 w-11 items-center justify-center rounded-full border border-cyan-300/25 bg-cyan-300/10 font-display text-base tracking-normal text-cyan-100">
              F
            </span>
            <span>Finvera</span>
          </a>
          <p class="max-w-xl text-sm leading-8 text-slate-300 sm:text-base">
            Finvera is a universal fintech operating layer for payment orchestration, treasury visibility, reconciliation, and control-first growth.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="chip">Payments</span>
            <span class="chip">Treasury</span>
            <span class="chip">Reconciliation</span>
            <span class="chip">Governance</span>
          </div>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-1 lg:gap-6">
          <div class="space-y-3">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Explore</p>
            <div class="flex flex-col gap-3 text-sm text-slate-300">
              {site.nav.map((item) => (
                <a href={item.href} class="hover:text-white">{item.label}</a>
              ))}
            </div>
          </div>
          <div class="space-y-3">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Contact</p>
            <div class="flex flex-col gap-3 text-sm text-slate-300">
              <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
              <a href="/contact" class="hover:text-white">Book a walkthrough</a>
              <a href="/security" class="hover:text-white">Security overview</a>
            </div>
          </div>
        </div>

        <div class="space-y-4 rounded-[28px] border border-white/8 bg-slate-950/30 p-5 sm:p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Why this build works</p>
          <div class="grid gap-3 text-sm leading-7 text-slate-300">
            <p>Static-first rendering keeps the site fast and clean on mobile.</p>
            <p>Route-level SEO gives the brand room to rank beyond a single homepage.</p>
            <p>The design system is compact enough to scale without turning generic.</p>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3 border-t border-white/8 pt-5 text-sm text-slate-500 md:flex-row md:items-center md:justify-between">
        <p>2026 Finvera. Concept landing for a universal fintech platform.</p>
        <p>Built in Astro with a static-first, responsive-first architecture.</p>
      </div>
    </div>
  </div>
</footer>
