---
import type { FaqItem } from '../data/site';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="grid gap-4">
  {items.map((item) => (
    <details class="content-card group p-0">
      <summary class="flex cursor-pointer items-start justify-between gap-5 px-5 py-5 sm:px-6 sm:py-6">
        <span class="font-display text-lg leading-7 text-white sm:text-xl">{item.question}</span>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/6 text-lg text-slate-200">
          +
        </span>
      </summary>
      <div class="px-5 pb-5 pt-0 sm:px-6 sm:pb-6">
        <p class="text-sm leading-7 text-slate-300 sm:text-base">{item.answer}</p>
      </div>
    </details>
  ))}
</div>
