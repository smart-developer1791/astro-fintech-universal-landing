---
import CtaBanner from '../../components/CtaBanner.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { absoluteUrl, industries, site, solutions } from '../../data/site';

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution }
  }));
}

const { solution } = Astro.props;
const relatedIndustries = industries.filter((industry) => solution.relatedIndustries.includes(industry.slug));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${site.name} ${solution.title}`,
  description: solution.description,
  provider: {
    '@type': 'Organization',
    name: site.legalName,
    url: site.url
  },
  areaServed: 'Global',
  url: absoluteUrl(`/solutions/${solution.slug}`)
};
---

<MainLayout
  title={solution.title}
  description={solution.summary}
  path={`/solutions/${solution.slug}`}
  schema={schema}
>
  <PageHero
    eyebrow="Solution"
    title={solution.title}
    description={solution.description}
    highlights={solution.outcomes.map((outcome) => `${outcome.value} ${outcome.label}`)}
  >
    <a slot="actions" href="/contact" class="button-primary w-full sm:w-auto">Book a walkthrough</a>
    <a slot="actions" href="/solutions" class="button-secondary w-full sm:w-auto">Back to solutions</a>
  </PageHero>

  <section class="shell section-space">
    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="content-card">
        <SectionHeading
          eyebrow="Challenges"
          title="Where this operating motion usually breaks first"
          description="The strongest solution pages start with the real friction teams feel before they ever ask for more product detail."
        />
        <div class="mt-8 grid gap-4">
          {solution.painPoints.map((item) => (
            <div class="soft-card text-sm leading-7 text-slate-200">
              {item}
            </div>
          ))}
        </div>
      </article>

      <article class="content-card">
        <SectionHeading
          eyebrow="Capabilities"
          title="How Finvera supports the workflow in practice"
          description="The point is not more feature noise. It is giving the team better control, clearer ownership, and fewer blind spots."
        />
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {solution.capabilities.map((capability) => (
            <div class="soft-card text-sm leading-7 text-slate-200">
              {capability}
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="shell section-space pt-0">
    <SectionHeading
      eyebrow="Outcomes"
      title="What better operating design changes for the team"
      description="The proof layer stays grounded in commercial and operational outcomes instead of vague enterprise language."
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {solution.outcomes.map((outcome) => (
        <article class="content-card surface-grid">
          <p class="metric-value">{outcome.value}</p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.18em] text-slate-300">{outcome.label}</p>
          <p class="mt-4 text-sm leading-7 text-slate-300">{outcome.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section-space pt-0">
    <SectionHeading
      eyebrow="Industry fit"
      title="Teams that usually feel this pain most sharply"
      description="These adjacent pages keep the story moving for buyers who want to see the platform through the lens of their own operating model."
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2 2xl:grid-cols-3">
      {relatedIndustries.map((industry) => (
        <article class="content-card flex h-full flex-col last:md:col-span-2 last:md:max-w-[46rem] last:md:justify-self-center last:2xl:col-span-1 last:2xl:max-w-none last:2xl:justify-self-auto">
          <h2 class="font-display text-2xl text-white">{industry.title}</h2>
          <p class="mt-3 text-sm leading-7 text-slate-300">{industry.summary}</p>
          <a href={`/industries/${industry.slug}`} class="mt-6 button-secondary w-full sm:w-auto">View industry page</a>
        </article>
      ))}
    </div>
  </section>

  <CtaBanner
    title="Need this solution page to work harder as a conversion route?"
    description="The structure is already ready for deeper proof, comparisons, vertical variants, and case studies without changing the core foundation."
    primaryHref="/contact"
    primaryLabel="Expand the solution"
    secondaryHref="/blog"
    secondaryLabel="Review related insights"
  />
</MainLayout>
