---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { absoluteUrl, articles, site } from '../../data/site';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const formatter = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.excerpt,
  datePublished: article.publishedAt,
  author: {
    '@type': 'Organization',
    name: site.legalName
  },
  publisher: {
    '@type': 'Organization',
    name: site.legalName,
    url: site.url
  },
  url: absoluteUrl(`/blog/${article.slug}`)
};
---

<MainLayout title={article.title} description={article.excerpt} path={`/blog/${article.slug}`} schema={schema}>
  <PageHero
    eyebrow={article.category}
    title={article.title}
    description={article.summary}
    highlights={[formatter.format(new Date(article.publishedAt)), article.readingTime]}
  >
    <a slot="actions" href="/blog" class="button-secondary">Back to insights</a>
    <a slot="actions" href="/contact" class="button-primary">Talk to the team</a>
  </PageHero>

  <section class="shell section-space">
    <article class="content-card mx-auto max-w-4xl px-6 py-8 md:px-10 md:py-10">
      <div class="space-y-10">
        {article.sections.map((section) => (
          <section class="space-y-4">
            <h2 class="font-display text-3xl text-white">{section.heading}</h2>
            <div class="space-y-4 text-base leading-8 text-slate-300">
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        ))}
      </div>
    </article>
  </section>
</MainLayout>
