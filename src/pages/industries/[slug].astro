---
import CtaBanner from '../../components/CtaBanner.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { absoluteUrl, industries, site, solutions } from '../../data/site';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry }
  }));
}

const { industry } = Astro.props;
const relatedSolutions = solutions.filter((solution) => industry.relatedSolutions.includes(solution.slug));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${site.name} for ${industry.title}`,
  description: industry.description,
  provider: {
    '@type': 'Organization',
    name: site.legalName,
    url: site.url
  },
  areaServed: 'Global',
  url: absoluteUrl(`/industries/${industry.slug}`)
};
---

<MainLayout
  title={industry.title}
  description={industry.summary}
  path={`/industries/${industry.slug}`}
  schema={schema}
>
  <PageHero
    eyebrow="Industry"
    title={industry.title}
    description={industry.description}
    highlights={industry.outcomes.map((outcome) => `${outcome.value} ${outcome.label}`)}
  >
    <a slot="actions" href="/contact" class="button-primary w-full sm:w-auto">Talk about your segment</a>
    <a slot="actions" href="/industries" class="button-secondary w-full sm:w-auto">Back to industries</a>
  </PageHero>

  <section class="shell section-space">
    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="content-card">
        <SectionHeading
          eyebrow="Priorities"
          title="What this team is usually trying to protect or unlock"
          description="A useful vertical page starts by naming the pressures that actually shape decision-making for that audience."
        />
        <div class="mt-8 grid gap-4">
          {industry.priorities.map((priority) => (
            <div class="soft-card text-sm leading-7 text-slate-200">
              {priority}
            </div>
          ))}
        </div>
      </article>

      <article class="content-card">
        <SectionHeading
          eyebrow="Typical workflows"
          title="Where Finvera fits the day-to-day operating motion"
          description="The page should feel like it understands how the team works, not like a generic feature matrix with a new headline."
        />
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {industry.workflows.map((workflow) => (
            <div class="soft-card text-sm leading-7 text-slate-200">
              {workflow}
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="shell section-space pt-0">
    <SectionHeading
      eyebrow="Outcomes"
      title="Proof points that feel grounded in the actual operating model"
      description="These cards stay believable because they tie benefit back to how the team runs the business every day."
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {industry.outcomes.map((outcome) => (
        <article class="content-card surface-grid">
          <p class="metric-value">{outcome.value}</p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.18em] text-slate-300">{outcome.label}</p>
          <p class="mt-4 text-sm leading-7 text-slate-300">{outcome.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section-space pt-0">
    <SectionHeading
      eyebrow="Recommended solutions"
      title="Solution pages that usually matter next"
      description="These companion routes help the buyer keep exploring the platform through their own priorities and workflows."
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2 2xl:grid-cols-3">
      {relatedSolutions.map((solution) => (
        <article class="content-card flex h-full flex-col last:md:col-span-2 last:md:max-w-[46rem] last:md:justify-self-center last:2xl:col-span-1 last:2xl:max-w-none last:2xl:justify-self-auto">
          <h2 class="font-display text-2xl text-white">{solution.title}</h2>
          <p class="mt-3 text-sm leading-7 text-slate-300">{solution.summary}</p>
          <a href={`/solutions/${solution.slug}`} class="mt-6 button-secondary w-full sm:w-auto">View solution page</a>
        </article>
      ))}
    </div>
  </section>

  <CtaBanner
    title="Need this vertical page to become a stronger acquisition route?"
    description="The layout is ready for richer segment proof, customer language, and deeper commercial detail without rebuilding the system underneath it."
    primaryHref="/contact"
    primaryLabel="Expand the vertical"
    secondaryHref="/solutions"
    secondaryLabel="Review solutions"
  />
</MainLayout>
